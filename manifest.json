{
  "manifest_version": 3,
  "name": "Stremio PiP - Picture-in-Picture with Subtitles",
  "version": "1.1.1",
  "description": "Enables Document Picture-in-Picture for Stremio Web with HTML subtitle overlays visible in the PiP window.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle PiP"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.stremio.com/*"],
      "js": [
        "src/dom-detector.js",
        "src/css-sync.js",
        "src/pip-manager.js",
        "src/pip-controls.js",
        "src/notification.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
